# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# local UX walkthrough dumps
/scripts/ux-evidence/

# next.js
/.next/
/out/
.turbo
next-env.d.ts

# production
/build

# prisma
/src/generated/prisma

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript / tooling caches
*.tsbuildinfo
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vendor agent skills (installed locally by Prisma CLI)
skills-lock.json
.agents/skills/prisma-*/
.claude/skills/prisma-*/
.windsurf/skills/prisma-*/

# os / editor
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
.idea/
*.swp
*.swo
